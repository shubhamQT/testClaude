    "cases": [
      {
        "id": "a35ba65a-9111-44bb-a2c4-b046a47fad44",
        "title": "E2E: Validation error shown when Last Name is left blank during Lead creation",
        "priority": "P0",
        "platforms": [
          "chrome"
        ],
        "preconditions": [
          "User is authenticated as Sales Representative"
        ],
        "steps": [
          {
            "id": "s1",
            "action": "tap",
            "targetDescription": "Navigate to Leads tab",
            "screenName": "HomePage",
            "pageObjectMethod": "clickLeads"
          },
          {
            "id": "s2",
            "action": "tap",
            "targetDescription": "Click New button",
            "screenName": "LeadListPage",
            "pageObjectMethod": "clickNew"
          },
          {
            "id": "s3",
            "action": "assertVisible",
            "targetDescription": "New Lead form is displayed",
            "screenName": "LeadListPage",
            "pageObjectMethod": "expectNewLeadVisible"
          },
          {
            "id": "s4",
            "action": "fill",
            "targetDescription": "Enter First Name",
            "screenName": "LeadListPage",
            "pageObjectMethod": "fillFirstName",
            "value": "John"
          },
          {
            "id": "s5",
            "action": "fill",
            "targetDescription": "Enter Company only, leave Last Name blank",
            "screenName": "LeadListPage",
            "pageObjectMethod": "fillCompany",
            "value": "ABC Technologies"
          },
          {
            "id": "s6",
            "action": "tap",
            "targetDescription": "Click Save button",
            "screenName": "LeadListPage",
            "pageObjectMethod": "clickSaveEdit"
          },
          {
            "id": "s7",
            "action": "assertVisible",
            "targetDescription": "Validation error appears for Last Name field",
            "locatorHint": "text=/Complete this field|required/i"
          },
          {
            "id": "s8",
            "action": "assertVisible",
            "targetDescription": "User remains on New Lead form (not saved)",
            "screenName": "LeadListPage",
            "pageObjectMethod": "expectNewLeadVisible"
          }
        ],
        "tags": [
          "@e2e",
          "@regression",
          "@lead"
        ]
      },
