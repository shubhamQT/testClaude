  "suiteName": "US-001 - Create Lead",
  "case": {
    "id": "1405837e-5886-4359-bc2a-aa0d31d1ca24",
    "title": "Create Lead with all provided test data fields successfully",
    "priority": "P0",
    "platforms": [
      "chrome"
    ],
    "preconditions": [
      "User is authenticated and on the Home page"
    ],
    "steps": [
      {
        "id": "step-1",
        "action": "openUrl",
        "targetDescription": "Navigate to the application home page",
        "value": "/"
      },
      {
        "id": "step-2",
        "action": "tap",
        "targetDescription": "Leads tab in navigation",
        "screenName": "HomePage",
        "pageObjectMethod": "clickLeads"
      },
      {
        "id": "step-3",
        "action": "tap",
        "targetDescription": "New button on Leads list page",
        "screenName": "LeadListPage",
        "pageObjectMethod": "clickNew"
      },
      {
        "id": "step-4",
        "action": "fill",
        "targetDescription": "First Name field",
        "screenName": "LeadListPage",
        "pageObjectMethod": "fillFirstName",
        "value": "John"
      },
      {
        "id": "step-5",
        "action": "fill",
        "targetDescription": "Last Name field",
        "screenName": "LeadListPage",
        "pageObjectMethod": "fillLastName",
        "value": "Smith"
      },
      {
        "id": "step-6",
        "action": "fill",
        "targetDescription": "Company field",
        "screenName": "LeadListPage",
        "pageObjectMethod": "fillCompany",
        "value": "ABC Technologies"
      },
      {
        "id": "step-7",
        "action": "fill",
        "targetDescription": "Phone field",
        "screenName": "LeadListPage",
        "pageObjectMethod": "fillPhone",
        "value": "9989876789"
      },
      {
        "id": "step-8",
        "action": "fill",
        "targetDescription": "Email field",
        "screenName": "LeadListPage",
        "pageObjectMethod": "fillEmail",
        "value": "john.smith@example.com"
      },
      {
        "id": "step-9",
        "action": "selectOption",
        "targetDescription": "Lead Source dropdown",
        "screenName": "LeadListPage",
        "pageObjectMethod": "clickLeadSource",
        "value": "Web"
      },
      {
        "id": "step-10",
        "action": "tap",
        "targetDescription": "Save button",
        "screenName": "LeadListPage",
        "pageObjectMethod": "clickSaveEdit"
      },
      {
        "id": "step-11",
        "action": "assertVisible",
        "targetDescription": "Newly created Lead record page is displayed",
        "screenName": "LeadPage",
        "pageObjectMethod": "expectLeadVisible"
      }
    ],
    "tags": [
      "@functional",
      "@regression"
    ]
