{
  "id": "1609378e-751b-42b4-b17b-ef42cb98008e",
  "testPlanId": "15ebbb82-d226-423f-8f34-54641e16026b",
  "requirementId": "0f79ec14-b4b4-41c4-9fcc-3a26fb6f1292",
  "suiteName": "US-001 - Create Lead",
  "case": {
    "id": "1609378e-751b-42b4-b17b-ef42cb98008e",
    "title": "Create Lead with all mandatory fields (Last Name and Company) successfully",
    "priority": "P0",
    "platforms": [
      "chrome"
    ],
    "preconditions": [
      "User is authenticated and on the Home page"
    ],
    "steps": [
      {
        "id": "step-1",
        "action": "openUrl",
        "targetDescription": "Navigate to the application home page",
        "value": "/"
      },
      {
        "id": "step-2",
        "action": "tap",
        "targetDescription": "Leads tab in navigation",
        "screenName": "HomePage",
        "pageObjectMethod": "clickLeads"
      },
      {
        "id": "step-3",
        "action": "tap",
        "targetDescription": "New button on Leads list page",
        "screenName": "LeadListPage",
        "pageObjectMethod": "clickNew"
      },
      {
        "id": "step-4",
        "action": "fill",
        "targetDescription": "Last Name field",
        "screenName": "LeadListPage",
        "pageObjectMethod": "fillLastName",
        "value": "Smith"
      },
      {
        "id": "step-5",
        "action": "fill",
        "targetDescription": "Company field",
        "screenName": "LeadListPage",
        "pageObjectMethod": "fillCompany",
        "value": "ABC Technologies"
      },
      {
        "id": "step-6",
        "action": "tap",
        "targetDescription": "Save button",
        "screenName": "LeadListPage",
        "pageObjectMethod": "clickSaveEdit"
      },
      {
        "id": "step-7",
        "action": "assertVisible",
        "targetDescription": "Newly created Lead record page is displayed",
        "screenName": "LeadPage",
        "pageObjectMethod": "expectLeadVisible"
      }
    ],
    "tags": [
      "@functional",
      "@regression"
    ]
  }
}
